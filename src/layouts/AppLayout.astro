---
import "@fontsource-variable/inter/index.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/llave15.css";

/** Raíz del sistema (BG-22): fuentes, tokens y estilos, sin nada de la portada heredada. */
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** URL absoluta; nunca se emite junto con `noindex`. */
  canonical?: string;
}

const { title, description, noindex = false, canonical } = Astro.props;
---

<!doctype html>
<html lang="es-CL" class="l15">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={interLatin} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/brand/llave15-distintivo.svg" />
    <link rel="icon" type="image/svg+xml" sizes="16x16" href="/brand/llave15-favicon-16.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
