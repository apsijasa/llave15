---
import Base from "./Base.astro";
import "../styles/taller-layout.css";
import "../styles/taller-components.css";
import { SITE } from "../lib/site.ts";
import { can, ROLE_LABELS } from "../server/auth/permissions.ts";
import type { Action, Role } from "../server/auth/permissions.ts";

interface Props {
  title: string;
  description: string;
  path: string;
  user: { name: string; role: Role; libraryCurator?: boolean };
}

const { title, description, path, user } = Astro.props;
type Link = { label: string; href: string; action: Action };
const groups: { label: string; links: Link[] }[] = [
  {
    label: "Operación",
    links: [
      { label: "Inicio", href: "/taller", action: "orders.edit" },
      { label: "Buscar", href: "/taller/buscar", action: "orders.edit" },
      { label: "Órdenes", href: "/taller/ordenes", action: "orders.edit" },
      { label: "Recepción", href: "/taller/recepcion/nueva", action: "reception.perform" },
      { label: "Reservas", href: "/taller/reservas", action: "bookings.manage" },
      { label: "Agenda", href: "/admin", action: "admin.panel" },
    ],
  },
  {
    label: "Gestión",
    links: [
      { label: "Clientes", href: "/taller/clientes", action: "customers.manage" },
      { label: "Catálogo", href: "/taller/catalogo", action: "catalog.view" },
      { label: "Indicadores", href: "/taller/indicadores", action: "dashboard.finance" },
      { label: "Usuarios", href: "/taller/usuarios", action: "users.manage" },
      { label: "Bloqueos", href: "/admin/bloqueos", action: "admin.panel" },
    ],
  },
  {
    label: "Conocimiento",
    links: [
      { label: "Biblioteca", href: "/taller/biblioteca", action: "library.view" },
      { label: "Asistente", href: "/taller/biblioteca/asistente", action: "library.ai" },
      { label: "Propuestas", href: "/taller/biblioteca/propuestas", action: "library.propose" },
      { label: "Revisión", href: "/taller/biblioteca/revision", action: "library.curate" },
    ],
  },
  {
    label: "Inventario y caja",
    links: [
      { label: "Inventario", href: "/taller/inventario", action: "inventory.view" },
      { label: "Ventas", href: "/taller/ventas", action: "sales.record" },
      { label: "Caja", href: "/taller/caja", action: "cash.open_close" },
      { label: "Proveedores", href: "/taller/proveedores", action: "purchases.manage" },
      { label: "Compras", href: "/taller/compras", action: "purchases.manage" },
      { label: "Gastos", href: "/taller/gastos", action: "expenses.record" },
    ],
  },
];
// El menú se arma en el servidor: un grupo sin enlaces permitidos no se muestra.
const menu = groups
  .map((group) => ({
    ...group,
    links: group.links.filter(
      (link) =>
        can(user.role, link.action) &&
        (link.action !== "library.curate" || user.libraryCurator === true),
    ),
  }))
  .filter((group) => group.links.length > 0);
// En "Conocimiento" una subruta marca el enlace de prefijo más largo (Asistente, no Biblioteca).
const knowledgeCurrent = groups
  .flatMap((group) => (group.label === "Conocimiento" ? group.links : []))
  .filter((link) => path === link.href || path.startsWith(`${link.href}/`))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<Base title={title} description={description} path={path} chrome="none" noindex>
  <div class="taller">
    <aside class="taller-aside">
      <div class="taller-id">
        <p class="taller-brand">{SITE.name} · Taller</p>
        <p class="taller-user">{user.name} · <span class="role">{ROLE_LABELS[user.role]}</span></p>
        <button type="button" class="taller-toggle" popovertarget="taller-menu">Menú</button>
      </div>
      <div class="taller-panel" id="taller-menu" popover="auto">
        <button
          type="button"
          class="taller-close"
          popovertarget="taller-menu"
          popovertargetaction="hide"
        >
          Cerrar
        </button>
        <nav aria-label="Taller">
          {
            menu.map((group) => (
              <div class="taller-group">
                <p class="label">{group.label}</p>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={path === link.href || (group.label === "Conocimiento" && knowledgeCurrent === link.href) ? "page" : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
        <form method="post" action="/admin/logout" class="taller-exit">
          <button type="submit" class="btn ghost">Salir</button>
        </form>
      </div>
    </aside>
    <section class="taller-content"><slot /></section>
  </div>
</Base>
