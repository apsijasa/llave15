---
interface Props {
  title: string;
  bars: { label: string; value: number; text: string }[];
}
const { title, bars } = Astro.props;
const max = Math.max(1, ...bars.map((bar) => bar.value));
const step = 432 / Math.max(1, bars.length);
---
<figure class="chart">
  <figcaption>{title}</figcaption>
  <svg viewBox="0 0 480 208" width="100%" role="img" aria-label={title}>
    <line x1="24" y1="164" x2="456" y2="164" stroke="var(--rule)" />
    {bars.map((bar, index) => <g>
      <rect x={24 + index * step + step * 0.2} y={164 - bar.value * 120 / max} width={step * 0.6} height={bar.value * 120 / max} fill="var(--ink)" />
      <text x={24 + (index + 0.5) * step} y={152 - bar.value * 120 / max} text-anchor="middle">{bar.text}</text>
      <text x={24 + (index + 0.5) * step} y="188" text-anchor="middle">{bar.label}</text>
    </g>)}
  </svg>
  <table class="dense chart-data"><caption>{title}</caption><thead><tr><th scope="col">Grupo</th><th scope="col">Trabajos</th></tr></thead><tbody>{bars.map((bar) => <tr><th scope="row">{bar.label}</th><td>{bar.text}</td></tr>)}</tbody></table>
</figure>
