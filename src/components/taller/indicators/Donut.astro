---
interface Props {
  id: string;
  title: string;
  center: string;
  centerCaption?: string;
  segments: { label: string; value: number; text: string }[];
  footer?: { label: string; value: string }[];
}
const { id, title, center, centerCaption, segments, footer = [] } = Astro.props;
const patternId = `${id}-hatch`;
const total = segments.reduce((sum, s) => sum + Math.max(0, s.value), 0);
const fills = ["var(--ink)", `url(#${patternId})`, "var(--hatch)"];
let offset = 0;
const arcs = segments.map((s, index) => {
  const length = total > 0 ? (Math.max(0, s.value) * 100) / total : 0;
  const arc = { ...s, length, offset, fill: fills[index % fills.length] };
  offset += length;
  return arc;
});
---
<figure class="chart donut">
  <figcaption>{title}</figcaption>
  <svg viewBox="0 0 240 208" width="100%" role="img" aria-label={title}>
    <defs><pattern id={patternId} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="var(--surface)" /><line x1="0" y1="0" x2="0" y2="6" stroke="var(--ink-2)" stroke-width="2" /></pattern></defs>
    <circle cx="120" cy="96" r="68" fill="none" stroke="var(--rule)" stroke-width="20" />
    {arcs.map((arc) => <circle cx="120" cy="96" r="68" fill="none" stroke={arc.fill} stroke-width="20" pathLength="100" stroke-dasharray={`${arc.length} ${100 - arc.length}`} stroke-dashoffset={-arc.offset} transform="rotate(-90 120 96)" />)}
    <circle cx="120" cy="96" r="78" fill="none" stroke="var(--steel)" stroke-width="1" />
    <circle cx="120" cy="96" r="58" fill="none" stroke="var(--steel)" stroke-width="1" />
    <text x="120" y="100" text-anchor="middle" class="donut-center">{center}</text>
    {centerCaption && <text x="120" y="196" text-anchor="middle">{centerCaption}</text>}
  </svg>
  <table class="dense chart-data"><caption>{title}</caption><thead><tr><th scope="col">Indicador</th><th scope="col">Valor</th></tr></thead><tbody>
    {segments.map((s) => <tr><th scope="row">{s.label}</th><td>{s.text}</td></tr>)}
    {footer.map((s) => <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>)}
  </tbody><tfoot><tr><th scope="row">{centerCaption ?? "Total"}</th><td>{center}</td></tr></tfoot></table>
  <ul class="donut-legend">{segments.map((s, index) => <li><span class={`donut-key donut-key--${index % 3}`} aria-hidden="true"></span><span>{s.label}</span><strong>{s.text}</strong></li>)}</ul>
  {footer.length > 0 && <dl class="panel-facts">{footer.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl>}
</figure>
<style is:global>
  .taller .donut svg { max-width: 280px; justify-self: center; }
  .taller .donut svg .donut-center { font-size: 20px; font-weight: 600; }
  .taller .donut-legend { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .taller .donut-legend li { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 8px; align-items: baseline; font-size: 14px; }
  .taller .donut-legend strong { font-weight: 500; font-variant-numeric: tabular-nums; }
  .taller .donut-key { width: 12px; height: 12px; display: inline-block; border: 1px solid var(--steel); background: var(--ink); }
  .taller .donut-key--1 { background: var(--surface); border: 3px double var(--ink-2); transform: rotate(45deg); }
  .taller .donut-key--2 { background: var(--hatch); }
</style>
