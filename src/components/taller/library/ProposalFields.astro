---
import { PROPOSAL_KIND_LABELS, PROPOSAL_KINDS } from "../../../server/library/rules.ts";

interface Props {
  values: Record<string, string>;
  errors: Record<string, string>;
  articles: readonly { id: string; title: string }[];
  variants: readonly { id: string; label: string }[];
}

const { values, errors, articles, variants } = Astro.props;
const invalid = (key: string) => (errors[key] ? "true" : undefined);
const described = (key: string) => (errors[key] ? `${key}-error` : undefined);
---

<div class="fields proposal-fields">
  <div class="field">
    <label for="kind">Tipo</label>
    <select id="kind" name="kind" required aria-invalid={invalid("kind")} aria-describedby={described("kind")}>
      {PROPOSAL_KINDS.map((kind) => <option value={kind} selected={values.kind === kind}>{PROPOSAL_KIND_LABELS[kind]}</option>)}
    </select>
    {errors.kind && <p id="kind-error">{errors.kind}</p>}
  </div>
  <div class="field">
    <label for="title">Título</label>
    <input id="title" name="title" type="text" required minlength="5" maxlength="160" value={values.title ?? ""} aria-invalid={invalid("title")} aria-describedby={described("title")} />
    {errors.title && <p id="title-error">{errors.title}</p>}
  </div>
  <div class="field proposal-wide">
    <label for="contentMd">Contenido (Markdown)</label>
    <textarea id="contentMd" name="contentMd" rows="12" required minlength="20" maxlength="20000" aria-invalid={invalid("contentMd")} aria-describedby={described("contentMd")}>{values.contentMd ?? ""}</textarea>
    {errors.contentMd && <p id="contentMd-error">{errors.contentMd}</p>}
  </div>
  <div class="field proposal-wide">
    <label for="evidence">Fuente o evidencia</label>
    <textarea id="evidence" name="evidence" rows="3" maxlength="4000" aria-invalid={invalid("evidence")} aria-describedby={described("evidence")}>{values.evidence ?? ""}</textarea>
    {errors.evidence && <p id="evidence-error">{errors.evidence}</p>}
  </div>
  <div class="field">
    <label for="targetArticleId">Artículo a corregir (opcional)</label>
    <select id="targetArticleId" name="targetArticleId" aria-invalid={invalid("targetArticleId")} aria-describedby={described("targetArticleId")}>
      <option value="">Ninguno</option>
      {articles.map((article) => <option value={article.id} selected={values.targetArticleId === article.id}>{article.title}</option>)}
    </select>
    {errors.targetArticleId && <p id="targetArticleId-error">{errors.targetArticleId}</p>}
  </div>
  <div class="field">
    <label for="targetVariantId">Variante (opcional)</label>
    <select id="targetVariantId" name="targetVariantId" aria-invalid={invalid("targetVariantId")} aria-describedby={described("targetVariantId")}>
      <option value="">Ninguna</option>
      {variants.map((variant) => <option value={variant.id} selected={values.targetVariantId === variant.id}>{variant.label}</option>)}
    </select>
    {errors.targetVariantId && <p id="targetVariantId-error">{errors.targetVariantId}</p>}
  </div>
</div>

<style is:global>
  .taller .proposal-fields {
    grid-template-columns: minmax(0, 1fr);
  }
  .taller .proposal-fields select,
  .taller .proposal-fields input {
    min-height: 48px;
  }
  @media (min-width: 900px) {
    .taller .proposal-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .taller .proposal-fields .proposal-wide {
      grid-column: 1 / -1;
    }
  }
</style>
