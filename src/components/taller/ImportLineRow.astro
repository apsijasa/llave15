---
type Option = { value: string; label: string };
type Product = { productId: string; sku: string; name: string; unit: string };
interface Props {
  index: number;
  line: { code: string | null; description: string; quantity: number; unitCostClp: number };
  cost: string;
  match: Product | null;
  suggestions: Product[];
  options: Option[];
  categories: Option[];
  values: Record<string, string> | null;
  errors: Record<string, string>;
}
const { index, line, cost, match, suggestions, options, categories, values, errors } = Astro.props;
const prefix = `line-${index}-`;
const defaults: Record<string, string> = {
  mode: match ? "existing" : "create",
  productId: match?.productId ?? "",
  quantity: String(line.quantity),
  unitCostClp: String(line.unitCostClp),
  sku: line.code ?? "",
  name: line.description.slice(0, 120),
  category: "repuesto",
  unit: "unidad",
  priceClp: "",
};
const value = (key: string) => (values ? (values[prefix + key] ?? "") : (defaults[key] ?? ""));
const invalid = (key: string) => Boolean(errors[prefix + key]);
const errorId = (key: string) => (invalid(key) ? `${prefix + key}-error` : undefined);
type Field = {
  key: string;
  label: string;
  type: "number" | "text";
  min?: number;
  max?: number;
};
const fields: Field[] = [
  { key: "quantity", label: "Cantidad", type: "number", min: 1, max: 10000 },
  { key: "unitCostClp", label: "Costo unitario neto", type: "number", min: 0, max: 10000000 },
  { key: "sku", label: "SKU del producto nuevo", type: "text" },
  { key: "name", label: "Nombre del producto nuevo", type: "text" },
  { key: "unit", label: "Unidad del producto nuevo", type: "text" },
  {
    key: "priceClp",
    label: "Precio de venta neto (obligatorio para crear)",
    type: "number",
    min: 0,
    max: 10000000,
  },
];
---

<fieldset class="stack">
  <legend>Línea {index + 1} · {line.description}</legend>
  {line.code && <code>{line.code}</code>}
  <p>Costo leído: {cost}</p>
  <div class="options">
    {[["existing", "Elegir producto existente"], ["create", "Crear producto nuevo"], ["skip", "Omitir línea"]].map(([mode, label]) => (
      <label for={prefix + mode}>
        <input id={prefix + mode} name={prefix + "mode"} type="radio" value={mode} checked={value("mode") === mode} aria-invalid={invalid("mode")} aria-describedby={errorId("mode")} /> {label}
      </label>
    ))}
  </div>
  {errors[prefix + "mode"] && <p id={errorId("mode")}>{errors[prefix + "mode"]}</p>}
  <div class="field">
    <label for={prefix + "productId"}>Producto existente</label>
    <select id={prefix + "productId"} name={prefix + "productId"} aria-invalid={invalid("productId")} aria-describedby={errorId("productId")}>
      <option value="">Selecciona un producto</option>
      {match && <option value={match.productId} selected={value("productId") === match.productId}>{match.sku} · {match.name}</option>}
      {suggestions.length > 0 && <optgroup label="Sugerencias">{suggestions.map(p => <option value={p.productId} selected={value("productId") === p.productId}>{p.sku} · {p.name}</option>)}</optgroup>}
      <optgroup label="Todos">{options.filter(p => p.value !== match?.productId && !suggestions.some(s => s.productId === p.value)).map(p => <option value={p.value} selected={value("productId") === p.value}>{p.label}</option>)}</optgroup>
    </select>
    {errors[prefix + "productId"] && <p id={errorId("productId")}>{errors[prefix + "productId"]}</p>}
  </div>
  <div class="fields">
    {fields.map(field => <div class="field">
      <label for={prefix + field.key}>{field.label}</label>
      <input id={prefix + field.key} name={prefix + field.key} type={field.type} min={field.min} max={field.max} step={field.type === "number" ? "1" : undefined} value={value(field.key)} required={field.key === "priceClp" && value("mode") === "create"} aria-invalid={invalid(field.key)} aria-describedby={errorId(field.key)} />
      {errors[prefix + field.key] && <p id={errorId(field.key)}>{errors[prefix + field.key]}</p>}
    </div>)}
    <div class="field">
      <label for={prefix + "category"}>Categoría del producto nuevo</label>
      <select id={prefix + "category"} name={prefix + "category"} aria-invalid={invalid("category")} aria-describedby={errorId("category")}>
        {categories.map(category => <option value={category.value} selected={value("category") === category.value}>{category.label}</option>)}
      </select>
      {errors[prefix + "category"] && <p id={errorId("category")}>{errors[prefix + "category"]}</p>}
    </div>
  </div>
</fieldset>
