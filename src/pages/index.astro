---
import Landing from "../components/Landing.astro";
import Base from "../layouts/Base.astro";
import { VECTOR_BIKES_SITE } from "../../web/vector-bikes/src/content/site.ts";

export const prerender = true;
---

<Base
  title={VECTOR_BIKES_SITE.home.title}
  description={VECTOR_BIKES_SITE.home.description}
  path="/"
>
  <Landing siteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ""} />
</Base>
