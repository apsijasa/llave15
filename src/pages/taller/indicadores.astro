---
import { TIMEZONE } from "../../lib/time.ts";
import { PLATFORM } from "../../lib/platform.ts";
import { DateTime } from "luxon";
import Card from "../../components/taller/Card.astro";
import SectionHeader from "../../components/taller/indicators/SectionHeader.astro";
import KpiTile from "../../components/taller/indicators/KpiTile.astro";
import LineChart from "../../components/taller/indicators/LineChart.astro";
import BarChart from "../../components/taller/indicators/BarChart.astro";
import Donut from "../../components/taller/indicators/Donut.astro";
import Funnel from "../../components/taller/indicators/Funnel.astro";
import DetailTables from "../../components/taller/indicators/DetailTables.astro";
import ReportDownloads from "../../components/taller/indicators/ReportDownloads.astro";
import PageHeader from "../../components/taller/PageHeader.astro";
import TallerLayout from "../../layouts/TallerLayout.astro";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../server/auth/permissions.ts";
import { getDb } from "../../server/db/client.ts";
import { formatClp } from "../../server/email/templates.ts";
import {
  defaultRange,
  indicatorsRangeSchema,
  workshopIndicators,
} from "../../server/taller/indicators.ts";
import type { Indicators } from "../../server/taller/indicators.ts";
import { financeIndicators } from "../../server/taller/indicators-finance.ts";
import type { FinanceIndicators } from "../../server/taller/indicators-finance.ts";
import { PAYMENT_METHOD_LABELS } from "../../server/taller/rules.ts";

import { profileForBranch } from "../../server/shops/profile.ts";
import { dashboardIndicators } from "../../server/taller/indicators-dashboard.ts";
import { dashboardView } from "../../server/taller/indicators-view.ts";

export const prerender = false;

const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user) {
  const response = Astro.redirect(loginRedirect(Astro.url.pathname + Astro.url.search), 303);
  response.headers.set("cache-control", "no-store");
  return response;
}
if (!can(user.role, "dashboard.finance")) return forbiddenResponse();
Astro.response.headers.set("cache-control", "no-store");
if (Astro.request.method !== "GET") {
  return new Response(null, {
    status: 405,
    headers: { allow: "GET", "cache-control": "no-store" },
  });
}

const defaults = defaultRange(now);
const parsed = indicatorsRangeSchema.safeParse({
  from: Astro.url.searchParams.get("desde") ?? defaults.from,
  to: Astro.url.searchParams.get("hasta") ?? defaults.to,
});
if (!parsed.success) Astro.response.status = 422;
const range = parsed.success ? parsed.data : defaults;
const [indicators, finance, dashboard, profile] = await Promise.all([
  workshopIndicators(db, user, range, now),
  financeIndicators(db, user, range, now),
  dashboardIndicators(db, user, range, now),
  profileForBranch(db, user.branchId),
]);
if (!indicators || !finance || !dashboard) return forbiddenResponse();
const view = dashboardView(indicators, finance, dashboard);
const subtitle = profile ? `${profile.name} · ${view.rangeLabel}` : view.rangeLabel;

const reportLinks = [
  { report: "ingresos-egresos", label: "Ingresos y egresos (CSV)" },
  { report: "resumen", label: "Resumen del período (CSV)" },
  { report: "mecanicos", label: "Por mecánico (CSV)" },
].map(({ report, label }) => ({
  label,
  href: `/taller/indicadores/${report}.csv?desde=${encodeURIComponent(range.from)}&hasta=${encodeURIComponent(range.to)}`,
}));
const today = DateTime.fromJSDate(now, { zone: TIMEZONE });
const previousMonth = today.minus({ months: 1 });
const shortcuts = [
  { label: "Hoy", from: today, to: today },
  { label: "Esta semana", from: today.startOf("week"), to: today },
  { label: "Este mes", from: today.startOf("month"), to: today },
  { label: "Mes anterior", from: previousMonth.startOf("month"), to: previousMonth.endOf("month") },
].map(({ label, from, to }) => {
  const desde = from.toFormat("yyyy-MM-dd");
  const hasta = to.toFormat("yyyy-MM-dd");
  return {
    label,
    href: `?${new URLSearchParams({ desde, hasta })}`,
    active: range.from === desde && range.to === hasta,
  };
});
const kpis = [
  { label: "Ingresos", value: formatClp(indicators.income.totalClp) },
  { label: "Pagos", value: indicators.income.count },
  {
    label: "Entregas",
    value: indicators.delivered.count,
    detail: `Total entregado: ${formatClp(indicators.delivered.totalClp)}`,
  },
  { label: "Ticket promedio", value: formatClp(indicators.delivered.averageTicketClp) },
  { label: "Órdenes creadas", value: indicators.ordersCreated.count },
  {
    label: "Clientes atendidos",
    value: indicators.customers.served,
    detail: `${indicators.customers.newCount} nuevos / ${indicators.customers.returningCount} recurrentes`,
  },
  { label: "Conversión de reservas", value: `${indicators.bookings.conversionPct}%` },
];
const statusTables = [
  {
    id: "created",
    title: "Órdenes por estado",
    caption: "Órdenes por estado (creadas en el período)",
    rows: indicators.ordersCreated.byStatus,
  },
  { id: "open", title: "Abiertas hoy", caption: "Órdenes abiertas hoy", rows: indicators.openNow },
];
const serviceTables: { caption: string; rows: Indicators["topServices"]["byQuantity"] }[] = [
  { caption: "Servicios más pedidos por cantidad", rows: indicators.topServices.byQuantity },
  { caption: "Servicios más pedidos por monto", rows: indicators.topServices.byAmount },
];
const summaryTables = [
  {
    id: "bookings",
    title: "Reservas",
    rows: [
      ["Recibidas", indicators.bookings.received],
      ["Canceladas", indicators.bookings.cancelled],
      ["No asistió", indicators.bookings.noShow],
      ["Convertidas", indicators.bookings.converted],
    ],
  },
  {
    id: "coverage",
    title: "Cobertura",
    rows: [
      ["Órdenes recibidas", indicators.coverage.receivedCount],
      ["Checklist completo", `${indicators.coverage.checklistCompletePct}%`],
      ["Control de calidad aprobado", `${indicators.coverage.qcApprovedPct}%`],
      ["Informes", `${indicators.coverage.reportsPct}%`],
    ],
  },
];
const dateFormat = new Intl.DateTimeFormat("es-CL", {
  dateStyle: "short",
  timeStyle: "short",
  timeZone: TIMEZONE,
});

const byMethod = indicators.income.byMethod.map((r) => ({ ...r, amount: formatClp(r.amountClp) }));
const paymentRows = indicators.payments.map((r) => ({
  ...r,
  datetime: r.receivedAt.toISOString(),
  date: dateFormat.format(r.receivedAt),
  kind: r.kind === "abono" ? "Abono" : "Pago final",
  method: PAYMENT_METHOD_LABELS[r.method],
  amount: formatClp(r.amountClp),
}));
const formattedServices = serviceTables.map((table) => ({
  ...table,
  rows: table.rows.map((r) => ({ ...r, amount: formatClp(r.amountClp) })),
}));

function financeInventorySection(data: FinanceIndicators) {
  const money = (amount: number | undefined) => (amount === undefined ? [] : [formatClp(amount)]);
  const row = (label: string, values: string[]) => values.map((value) => ({ label, value }));
  return {
    title: "Inventario",
    rows: [
      { label: "Productos activos", value: String(data.inventory.activeCount) },
      { label: "Bajo mínimo", value: String(data.inventory.lowStockCount) },
      { label: "Sin stock", value: String(data.inventory.outOfStockCount) },
      ...row("Valor a costo", money(data.inventory.valueAtCostClp)),
      ...row("Margen de repuestos", money(data.partsMarginClp)),
    ],
  };
}

/** Secciones de la Etapa B; los costos solo existen si `financeIndicators` los envió. */
function financeSections(data: FinanceIndicators) {
  return [
    {
      title: "Egresos del período",
      rows: [
        { label: "Total", value: formatClp(data.expenses.totalClp) },
        ...data.expenses.byCategory.map((item) => ({
          label: item.label,
          value: formatClp(item.amountClp),
        })),
      ],
    },
    {
      title: "Balance",
      rows: [
        { label: "Ingresos netos", value: formatClp(data.income.netClp) },
        { label: "Devoluciones", value: formatClp(data.income.refundsClp) },
        { label: "Egresos", value: formatClp(data.expenses.totalClp) },
        { label: "Balance", value: formatClp(data.balanceClp) },
        { label: "Gastos sobre ingresos", value: `${data.expenseRatioPct}%` },
      ],
    },
    {
      title: "Mix de ingresos",
      rows: [
        { label: "Servicios", value: formatClp(data.mix.servicesClp) },
        { label: "Repuestos", value: formatClp(data.mix.partsClp) },
        { label: "Ventas de mostrador", value: formatClp(data.mix.counterSalesClp) },
      ],
    },
    {
      title: "POS por proveedor",
      rows: data.pos.map((entry) => ({ label: entry.label, value: formatClp(entry.grossClp) })),
    },
    financeInventorySection(data),
  ];
}
---

<TallerLayout title={`Indicadores — ${PLATFORM.name}`} description="Indicadores financieros y operativos del taller." path="/taller/indicadores" user={user}>
  <div class="stack indicators-page">
    <PageHeader title="Indicadores" subtitle={subtitle} />
    <Card title="Rango de fechas" id="range-title">
      {!parsed.success && <p role="alert" id="range-error">El rango no es válido: usa fechas yyyy-mm-dd, Desde anterior o igual a Hasta y hasta un año.</p>}
      <form method="get" class="indicators-range">
        <div class="field"><label for="desde">Desde</label><input type="date" id="desde" name="desde" value={range.from} required aria-invalid={!parsed.success} aria-describedby={!parsed.success ? "range-error" : undefined} /></div>
        <div class="field"><label for="hasta">Hasta</label><input type="date" id="hasta" name="hasta" value={range.to} required aria-invalid={!parsed.success} aria-describedby={!parsed.success ? "range-error" : undefined} /></div>
        <button type="submit" class="btn">Aplicar</button>
      </form>
      <nav class="indicators-shortcuts" aria-label="Atajos de fechas">
        {shortcuts.map((shortcut) => <a href={shortcut.href} aria-current={shortcut.active ? "page" : undefined}>{shortcut.label}</a>)}
      </nav>
    </Card>
    <ReportDownloads links={reportLinks} />
    <section aria-labelledby="overview-title">
      <SectionHeader id="overview-title" eyebrow="Visión general" title="El taller en una mirada" subtitle="Las cuatro señales principales para entender el período." />
      <div class="panel-kpis">{view.overview.primary.map((tile) => <KpiTile {...tile} />)}</div>
      <div class="panel-kpis panel-secondary">{view.overview.secondary.map((tile) => <KpiTile {...tile} />)}</div>
    </section>
    <section aria-labelledby="reading-title">
      <SectionHeader id="reading-title" eyebrow="Lectura financiera" title="Cómo se movió el dinero" subtitle="Evolución, resultado y origen de los ingresos." />
      <div class="panel-grid">
        <Card><LineChart {...view.finance.line}><dl class="panel-facts">{view.finance.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></LineChart></Card>
        <Card><Donut id="donut-result" {...view.finance.result} /></Card>
        <Card><Donut id="donut-mix" {...view.finance.mix} /></Card>
      </div>
    </section>
    <section aria-labelledby="pulse-title">
      <SectionHeader id="pulse-title" eyebrow="Pulso operativo" title="Qué está moviendo el taller" subtitle="Servicios, días y estados que concentran la carga de trabajo." />
      <div class="panel-grid">
        <Card><Funnel {...view.pulse.services} /></Card><Card><BarChart {...view.pulse.weekday} /></Card>
        <Card><Funnel {...view.pulse.statuses} /></Card><Card><BarChart {...view.pulse.ages} /></Card>
      </div>
    </section>
    <section aria-labelledby="opportunities-title">
      <SectionHeader id="opportunities-title" eyebrow="Oportunidades" title="De consultas a clientes" subtitle="Adicionales, agenda y recurrencia de clientes." />
      <div class="panel-grid">
        <Card><Funnel {...view.opportunities.approvals} /></Card>
        <Card><Funnel {...view.opportunities.bookings} /></Card>
        <Card><Donut id="donut-returning" {...view.opportunities.returning} /><dl class="panel-facts">{view.opportunities.clients.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></Card>
      </div>
    </section>
    <section aria-labelledby="control-title">
      <SectionHeader id="control-title" eyebrow="Control y calidad" title="Una operación bajo control" subtitle="Checklist, inventario y registro de pagos." />
      <div class="panel-grid">
        <Card><Donut id="donut-checklist" {...view.control.checklist} /><dl class="panel-facts">{view.control.coverage.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></Card>
        <Card label="Inventario"><h3>Inventario</h3><dl class="panel-facts">{view.control.inventory.map((s) => <div><dt>{s.status ? <span class={`status status--${s.status}`}>{s.label}</span> : s.label}</dt><dd>{s.value}</dd></div>)}</dl></Card>
        <Card><Donut id="donut-payment" {...view.control.payment} /></Card>
      </div>
    </section>
    <h2 id="detail-title">Detalle del período</h2>
    <DetailTables kpis={kpis} byMethod={byMethod} payments={paymentRows} statusTables={statusTables} serviceTables={formattedServices} summaryTables={summaryTables} financeSections={financeSections(finance)} />
  </div>
</TallerLayout>

<style is:global>
  .taller .indicators-page .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    font-variant-numeric: tabular-nums;
  }
  .taller .indicators-page .kpi-value {
    font-family: var(--mono);
    font-size: 1.5rem;
  }
  .taller .indicators-range,
  .taller .indicators-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: end;
  }
  .taller .indicators-shortcuts a {
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .taller .indicators-shortcuts a[aria-current="page"] {
    background: var(--ink);
    color: var(--on-ink);
  }
  .taller .indicators-page caption {
    text-align: left;
    padding-block-end: 8px;
    color: var(--ink-2);
  }
  .taller .panel-kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .taller .panel-secondary { margin-block-start: 16px; }
  .taller .panel-secondary .panel-kpi-value { font-size: 20px; line-height: 28px; }
  .taller .panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; align-items: start; }
  .taller .panel-grid > *, .taller .panel-kpis > * { min-width: 0; }
  .taller .panel-facts { display: grid; gap: 8px; margin: 0; font-size: 14px; }
  .taller .panel-facts > div { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
  .taller .panel-facts dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; }
  .taller .indicators-page .status--bajo { border-style: dashed; }
  .taller .indicators-page .status--sin-stock { border: 3px double currentColor; }
  @media (min-width: 1024px) { .taller .panel-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
