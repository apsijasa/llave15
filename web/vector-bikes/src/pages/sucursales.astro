---
import SiteLayout from "../layouts/SiteLayout.astro";
import { BOOKING_URL, BRANCHES, VECTOR_BIKES_SITE } from "../content/site.ts";

export const prerender = true;

const { weekdays, saturday } = VECTOR_BIKES_SITE.receptionHours;
---

<SiteLayout
  title={VECTOR_BIKES_SITE.branches.title}
  description={VECTOR_BIKES_SITE.branches.description}
  path="/sucursales"
>
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">Sucursales</span>
        <div>
          <h1>Dos talleres, la misma mecánica.</h1>
          <p>
            Reservas en el mismo sistema para las dos sucursales. Si vas a Santiago, escríbelo en
            la descripción de tu reserva.
          </p>
        </div>
      </div>

      <div class="branches">
        {
          BRANCHES.map((branch) => (
            <article class="branch">
              <h2 class="label">{branch.name}</h2>
              <p class="addr">
                {branch.streetAddress}
                <br />
                {branch.comuna}
              </p>
              <p class="branch-links">
                <a href={branch.mapsUrl} rel="noopener" target="_blank">
                  Abrir en Google Maps ↗
                </a>
                <a href={`tel:${branch.phone}`}>{branch.phoneDisplay}</a>
              </p>
              <table class="hours-table">
                <caption class="label">Horario de recepción</caption>
                <tbody>
                  <tr>
                    <th scope="row">Lunes a viernes</th>
                    <td>{weekdays.range}</td>
                  </tr>
                  <tr>
                    <th scope="row">Sábado</th>
                    <td>{saturday.range}</td>
                  </tr>
                  <tr>
                    <th scope="row">Domingo y feriados</th>
                    <td>Cerrado</td>
                  </tr>
                </tbody>
              </table>
            </article>
          ))
        }
      </div>

      <p class="branch-cta">
        <a href={BOOKING_URL} class="btn">Reservar hora</a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
  }
  .branches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 64px);
  }
  .branch .addr {
    margin-top: 14px;
  }
  .branch-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 12px;
  }
  .branch-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .branch .hours-table caption {
    caption-side: top;
    text-align: left;
    padding-top: 18px;
  }
  .branch .hours-table {
    margin-top: 0;
  }
  .branch-cta {
    margin-top: clamp(32px, 5vw, 48px);
  }
  @media (max-width: 760px) {
    .branches {
      grid-template-columns: 1fr;
    }
  }
</style>
