# Copiar a .env (el Bootstrap lo hace). En Replit, los valores reales van en Secrets y tienen precedencia.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/vector_bikes
# Origen heredado del sistema (convivencia de dominios hasta BG-DC3).
PUBLIC_SITE_URL=https://llave15.cl
# Dominio del sistema (https://llave15.cl); si queda vacío, se usa PUBLIC_SITE_URL.
APP_URL=
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SESSION_SECRET=dev-session-secret-change-me-0123456789abcd
CANCEL_TOKEN_SECRET=dev-cancel-secret-change-me-0123456789abcde
# Firma los enlaces de seguimiento (al menos 32 caracteres); si queda vacío, se usa CANCEL_TOKEN_SECRET. Los enlaces ya enviados siguen funcionando.
TRACKING_TOKEN_SECRET=
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Llave 15 <reservas@send.llave15.cl>"
# Solo los usa pnpm bg:backfill; cada taller toma los suyos de su fila en shops. Salen en BG-DC3.
EMAIL_REPLY_TO=taller@example.com
SHOP_NOTIFY_EMAIL=taller@example.com
PUBLIC_WHATSAPP_NUMBER=
# Optional direct Meta WhatsApp Cloud API integration. Keep disabled until Meta setup is complete.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_READY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es_CL
# Required by the external reminder cron endpoint when WhatsApp is enabled (minimum 32 characters).
CRON_SECRET=
# Secreto de las tareas programadas /api/tareas/* (mínimo 32 caracteres). El mismo valor va en Make.com.
TASKS_SECRET=dev-tasks-secret-change-me-0123456789ab
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Base solo para las pruebas de tablet (Playwright). Debe terminar en _e2e; global-setup la crea si falta.
E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/vector_bikes_e2e
# Almacenamiento de fotos y firmas: local (disco, desarrollo) o replit (App Storage, producción).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET_ID=
# Asistente de la biblioteca técnica: none (solo fuentes, sin servicio externo) o anthropic.
# Con anthropic, la clave va solo en Secrets de Replit, nunca en el repositorio.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
